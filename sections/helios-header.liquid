{% liquid
  assign main_menu = section.settings.menu
  capture feedback_url
    render 'helios-feedback-url', selected_page: section.settings.feedback_page
  endcapture
  assign feedback_url = feedback_url | strip
  capture collab_url
    render 'helios-collab-url', selected_page: section.settings.collab_page
  endcapture
  assign collab_url = collab_url | strip
  assign stores_url = section.settings.stores_page.url | default: pages['he-thong-cua-hang'].url
  if stores_url == blank
    assign stores_url = routes.search_url | append: '?type=page&q=he+thong+cua+hang'
  endif
  assign newest = collections['new-in']
  assign newest_url = newest.url
  if newest_url == blank
    assign newest_url = routes.all_products_collection_url | append: '?sort_by=created-descending'
  endif
%}
<header class="helios-header">
  <div class="helios-topbar">
    <div class="helios-topbar__contact wes-custom-order-notice" lang="{{ request.locale.iso_code | default: 'en' | escape }}">{{ 'wes_header.custom_order' | t }} {{ 'wes_header.email' | t }}: <a href="mailto:wesfreedkr@gmail.com">wesfreedkr@gmail.com</a></div>
    <helios-carousel class="helios-announcement" data-autoplay="{{ section.settings.announcement_autoplay }}" aria-label="{{ 'helios.announcements' | t | escape }}">
      <button type="button" data-helios-prev aria-label="{{ 'helios.announcement_prev' | t | escape }}">‹</button>
      <div><a data-helios-slide href="{{ section.settings.announcement_link | default: routes.all_products_collection_url | escape }}">{% render 'helios-text', value: section.settings.announcement %}</a><a data-helios-slide hidden href="{{ section.settings.secondary_announcement_link | default: routes.all_products_collection_url | escape }}">{% render 'helios-text', value: section.settings.secondary_announcement %}</a></div>
      <button type="button" data-helios-next aria-label="{{ 'helios.announcement_next' | t | escape }}">›</button>
      <button class="helios-announcement__pause" type="button" data-helios-toggle aria-label="{{ 'helios.announcement_pause' | t | escape }}">Ⅱ</button>
    </helios-carousel>
    <a class="helios-topbar__store" href="{{ stores_url }}">{{ 'helios.stores' | t }}</a>
  </div>
  <div class="helios-header__inner">
    <div class="helios-header__left">
    <details class="helios-menu" data-helios-menu data-helios-disclosure>
      <summary aria-label="{{ 'helios.menu_open' | t | escape }}"><span class="helios-menu__bars" aria-hidden="true"></span><span class="helios-menu__label">{{ 'wes_header.menu' | t }}</span></summary>
      <nav class="helios-menu__panel" aria-label="{{ 'helios.menu_main' | t | escape }}">
        <button class="helios-menu__close" type="button" data-helios-menu-close aria-label="{{ 'helios.menu_close' | t | escape }}">{{ 'helios.close_upper' | t }} <span aria-hidden="true">×</span></button>
        {% render 'helios-mega-menu', menu: main_menu, stores_url: stores_url, newest_url: newest_url, feedback_url: feedback_url, collab_url: collab_url %}
        <div class="helios-mobile-language">
          {% assign mobile_country_form_id = 'WesMobileCountry-' | append: section.id %}
          {% render 'wes-country-selector', form_id: mobile_country_form_id %}
          {% assign mobile_language_form_id = 'HeliosMobileLanguage-' | append: section.id %}
          {% render 'helios-language', form_id: mobile_language_form_id %}
        </div>
      </nav>
    </details>
    <nav class="helios-header__links" aria-label="{{ 'helios.discover' | t | escape }}">
      <a href="{{ newest_url }}">{{ 'wes_header.new_in' | t }}</a><a href="{{ feedback_url }}">{{ 'wes_header.feedback' | t }}</a><a href="{{ collab_url }}">{{ 'wes_header.collab' | t }}</a><details class="helios-discover" data-helios-disclosure><summary>{{ 'wes_header.discover' | t }}</summary><nav aria-label="{{ 'helios.explore' | t | escape }}">{% capture journal_url %}{% render 'helios-journal-url' %}{% endcapture %}<a href="{{ journal_url | strip }}">{{ 'wes_header.world' | t }}</a><a href="{{ routes.root_url }}#helios-story">{{ 'wes_header.about' | t }}</a><a href="{{ routes.collections_url }}">{{ 'helios.collections' | t }}</a>{% render 'helios-link', handle: '10-nam-ren-bac-magazine', label: 'TẠP CHÍ 10 NĂM', query: '10 năm', kind: 'page' %}</nav></details>
    </nav>
    </div>
    <a class="helios-logo{% if section.settings.logo == blank %} helios-logo--crisp{% endif %}" href="{{ routes.root_url }}" aria-label="WES FREED">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: 500 | image_tag: width: 220, loading: 'eager', alt: 'WES FREED' }}
      {% else %}
        <span class="wes-logo-part wes-logo-mark" aria-hidden="true"><img src="{{ 'wes-freed-wf-logo.png' | asset_url }}" alt="" width="1536" height="1024" loading="eager" fetchpriority="high"></span>
        <span class="wes-logo-part wes-logo-text" aria-hidden="true"><img src="{{ 'wes-freed-wf-logo.png' | asset_url }}" alt="" width="1536" height="1024" loading="eager"></span>
      {% endif %}
    </a>
    <div class="helios-header__actions">
      {% assign country_form_id = 'WesHeaderCountry-' | append: section.id %}
      {% render 'wes-country-selector', form_id: country_form_id %}
      {% assign language_form_id = 'HeliosLanguage-' | append: section.id %}
      {% render 'helios-language', form_id: language_form_id %}
      <a href="{{ routes.search_url }}" aria-label="{{ 'helios.search' | t | escape }}" class="helios-icon" data-bs-toggle="offcanvas" data-bs-target="#offcanvas-search" aria-controls="offcanvas-search">{% render 'svg-icons', icon: 'search' %}</a>
      {% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}" aria-label="{{ 'helios.account' | t | escape }}" class="helios-icon helios-account"><span class="helios-account__label">{{ 'helios.login' | t }}</span><span class="helios-account__icon">{% render 'svg-icons', icon: 'account' %}</span></a>{% endif %}
      <a href="{{ routes.cart_url }}" class="helios-icon helios-cart" aria-label="{{ 'helios.cart' | t | escape }}" data-bs-toggle="offcanvas" data-bs-target="#offcanvas-cart" aria-controls="offcanvas-cart">
        {% render 'svg-icons', icon: 'cart' %}{% render 'cart-count-badge' %}
      </a>
    </div>
  </div>
</header>
{% schema %}
{
  "name": "WES FREED · Header",
  "limit": 1,
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "text", "id": "announcement", "label": "Thông điệp", "default": "ĐÁNH SÁNG TRỌN ĐỜI" },
    { "type": "text", "id": "secondary_announcement", "label": "Thông báo thứ hai", "default": "WES FREED LÀM DẤU ẤN CỦA BẢN LĨNH" },
    { "type": "url", "id": "announcement_link", "label": "Đường dẫn thông điệp (trống: tất cả sản phẩm)" },
    { "type": "url", "id": "secondary_announcement_link", "label": "Đường dẫn thông báo thứ hai (trống: tất cả sản phẩm)" },
    { "type": "range", "id": "announcement_autoplay", "label": "Tự chuyển thông báo (0: tắt)", "min": 0, "max": 10, "step": 1, "unit": "s", "default": 5 },
    { "type": "page", "id": "feedback_page", "label": "Trang Feedback" },
    { "type": "page", "id": "collab_page", "label": "Trang Collab" },
    { "type": "page", "id": "stores_page", "label": "Trang hệ thống cửa hàng" },
    { "type": "image_picker", "id": "logo", "label": "Logo (mặc định dùng logo WES FREED)" },
    { "type": "link_list", "id": "menu", "label": "Menu chính" }
  ]
}
{% endschema %}
