{% liquid
  assign featured_collection = section.settings.collection | default: collections.all
  assign heading = section.settings.heading
%}
{% if featured_collection.products_count > 0 %}
  <section class="helios-products helios-container" aria-labelledby="helios-products-{{ section.id }}">
    <div class="helios-section-heading">
      <div><p class="helios-eyebrow">HANDCRAFTED BY HELIOS</p><h2 id="helios-products-{{ section.id }}">{{ heading | escape }}</h2></div>
      <a class="helios-text-link" href="{{ featured_collection.url | default: routes.all_products_collection_url }}">XEM TẤT CẢ <span aria-hidden="true">{% render 'helios-arrow' %}</span></a>
    </div>
    <ul class="helios-product-grid" role="list">
      {% for product in featured_collection.products limit: section.settings.limit %}
        <li>{% render 'product-card', product: product %}</li>
      {% endfor %}
    </ul>
  </section>
{% elsif request.design_mode %}
  <div class="helios-container helios-editor-notice">Chọn bộ sưu tập có sản phẩm đã xuất bản để hiển thị sản phẩm nổi bật. Theme không tạo sản phẩm mẫu.</div>
{% endif %}
{% schema %}
{
  "name": "HELIOS · Sản phẩm",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Tiêu đề", "default": "CHẾ TÁC NỔI BẬT" },
    { "type": "collection", "id": "collection", "label": "Bộ sưu tập (để trống: sản phẩm hiện có)" },
    { "type": "range", "id": "limit", "min": 4, "max": 12, "step": 4, "default": 8, "label": "Số sản phẩm tối đa" }
  ],
  "presets": [{ "name": "HELIOS · Sản phẩm" }]
}
{% endschema %}
