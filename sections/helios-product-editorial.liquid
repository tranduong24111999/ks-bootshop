<section class="helios-product-editorial" aria-labelledby="HeliosEditorial-{{ section.id }}">
  <helios-brand-film class="helios-brand-film">
    {% if section.settings.film_url != blank %}<video controls muted playsinline loop preload="none" poster="{{ 'helios-craft-poster.jpg' | asset_url }}" aria-label="Nghệ nhân và hành trình chế tác HELIOS"><source src="{{ section.settings.film_url }}" type="video/mp4"></video>{% else %}<img src="{{ 'helios-craft-poster.jpg' | asset_url }}" width="1600" height="682" loading="lazy" alt="Nghệ nhân chế tác HELIOS">{% endif %}
    <div class="helios-brand-film__caption"><h2 id="HeliosEditorial-{{ section.id }}">{{ section.settings.heading | escape }}</h2><div>{{ section.settings.description }}</div></div>
  </helios-brand-film>
  {% if section.blocks.size > 0 %}
    <div class="helios-product-faq"><h2>{{ section.settings.faq_heading | escape }}</h2>
      {% for block in section.blocks %}<details class="helios-product-faq__item" {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}<span aria-hidden="true">+</span></summary><div>{% if block.settings.page != blank %}{{ block.settings.page.content }}{% else %}{{ block.settings.answer }}{% endif %}</div></details>{% endfor %}
    </div>
  {% endif %}
</section>
{% schema %}
{
  "name": "HELIOS · Chế tác & FAQ",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Tiêu đề", "default": "10 NĂM RÈN BẠC - MỘT ĐỜI TẠC BẢN LĨNH" },
    { "type": "richtext", "id": "description", "label": "Nội dung", "default": "<p>Nơi mỗi chế tác được hoàn thiện bằng tay bởi nghệ nhân Việt, đồng hành cùng người đàn ông dám giữ lấy khác biệt, sống tự do theo cách của mình.</p>" },
    { "type": "url", "id": "film_url", "label": "Video MP4 thương hiệu", "default": "https://helios.vn/cdn/shop/videos/c/vp/c9f006cb17ef468da3ab4d6b24ea7d05/c9f006cb17ef468da3ab4d6b24ea7d05.HD-720p-4.5Mbps-95845063.mp4?v=0" },
    { "type": "text", "id": "faq_heading", "label": "Tiêu đề FAQ", "default": "Câu Hỏi Thường Gặp!" }
  ],
  "blocks": [{ "type": "question", "name": "Câu hỏi", "settings": [
    { "type": "text", "id": "question", "label": "Câu hỏi" },
    { "type": "richtext", "id": "answer", "label": "Trả lời" },
    { "type": "page", "id": "page", "label": "Dùng nội dung trang có sẵn (tùy chọn)" }
  ] }],
  "presets": [{ "name": "HELIOS · Chế tác & FAQ" }]
}
{% endschema %}
