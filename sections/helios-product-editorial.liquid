<section class="helios-product-editorial" aria-labelledby="HeliosEditorial-{{ section.id }}">
  <helios-brand-film class="helios-brand-film">
    {% if section.settings.film_url != blank %}<video controls muted playsinline loop preload="none" poster="{{ 'helios-craft-poster.jpg' | asset_url }}" aria-label="{{ 'helios.artisans' | t | escape }}"><source src="{{ section.settings.film_url }}" type="video/mp4"></video>{% else %}<img src="{{ 'helios-craft-poster.jpg' | asset_url }}" width="1600" height="682" loading="lazy" alt="{{ 'helios.artisan_image' | t | escape }}">{% endif %}
    <div class="helios-brand-film__caption"><h2 id="HeliosEditorial-{{ section.id }}">{% render 'helios-text', value: section.settings.heading %}</h2><div>{% render 'helios-text', value: section.settings.description, html: true %}</div></div>
  </helios-brand-film>
  {% if section.blocks.size > 0 %}
    <div class="helios-product-faq"><h2>{% render 'helios-text', value: section.settings.faq_heading %}</h2>
      {% for block in section.blocks %}<details class="helios-product-faq__item" {{ block.shopify_attributes }}><summary>{% render 'helios-text', value: block.settings.question %}<span aria-hidden="true">+</span></summary><div>{% if block.settings.page != blank %}{{ block.settings.page.content }}{% else %}{% render 'helios-text', value: block.settings.answer, html: true %}{% endif %}</div></details>{% endfor %}
    </div>
  {% endif %}
</section>
{% schema %}
{
  "name": "HELIOS · Chế tác & FAQ",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Tiêu đề",
      "default": "10 NĂM RÈN BẠC - MỘT ĐỜI TẠC BẢN LĨNH"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Nội dung",
      "default": "<p>Nơi mỗi chế tác được hoàn thiện bằng tay bởi nghệ nhân Việt, đồng hành cùng người đàn ông dám giữ lấy khác biệt, sống tự do theo cách của mình.</p>"
    },
    {
      "type": "url",
      "id": "film_url",
      "label": "Video MP4 thương hiệu"
    },
    {
      "type": "text",
      "id": "faq_heading",
      "label": "Tiêu đề FAQ",
      "default": "Câu Hỏi Thường Gặp!"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Câu hỏi",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Câu hỏi"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Trả lời"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Dùng nội dung trang có sẵn (tùy chọn)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HELIOS · Chế tác & FAQ"
    }
  ]
}
{% endschema %}
