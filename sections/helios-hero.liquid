<helios-carousel class="helios-hero" data-autoplay="{{ section.settings.autoplay }}" role="region" aria-roledescription="băng chuyền" aria-label="Bộ sưu tập HELIOS">
  <h1 class="visually-hidden">{{ section.settings.heading | escape }}</h1>
  <div class="helios-hero__slides">
    {% for block in section.blocks %}
      {% liquid
        assign film = block.settings.film | default: 'rings'
        assign film_prefix = 'helios-film-' | append: film
        assign desktop_video = film_prefix | append: '-desktop.mp4'
        assign mobile_video = film_prefix | append: '-mobile.mp4'
        assign desktop_poster = film_prefix | append: '-desktop.jpg'
        assign mobile_poster = film_prefix | append: '-mobile.jpg'
        assign destination = block.settings.collection.url | default: routes.all_products_collection_url
      %}
      <div class="helios-hero__slide{% if forloop.first %} is-active{% endif %}" data-helios-slide {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }} role="group" aria-roledescription="trang chiếu" aria-label="{{ forloop.index }} / {{ forloop.length }}">
        <video class="helios-hero__video" muted loop playsinline controls preload="none" poster="{{ desktop_poster | asset_url }}" data-desktop="{{ desktop_video | asset_url }}" data-mobile="{{ mobile_video | asset_url }}" data-poster-desktop="{{ desktop_poster | asset_url }}" data-poster-mobile="{{ mobile_poster | asset_url }}" aria-label="{{ block.settings.title | escape }}">
        </video>
        <noscript><style>.helios-hero__video { display:none; }.helios-hero__editorial { pointer-events:none; }.helios-hero__cta { pointer-events:auto; }</style><video class="helios-hero__video-fallback" aria-label="{{ block.settings.title | escape }}" controls muted loop playsinline preload="none" poster="{{ desktop_poster | asset_url }}"><source src="{{ desktop_video | asset_url }}" type="video/mp4"></video></noscript>
        <a class="helios-hero__editorial" href="{{ destination }}" aria-label="{{ block.settings.title | escape }} — Khám phá bộ sưu tập">
          <span class="helios-hero__eyebrow">HELIOS · FINE CRAFTSMANSHIP</span>
          <span class="helios-hero__title">{{ block.settings.title | escape }}</span>
          <span class="helios-hero__cta">KHÁM PHÁ BỘ SƯU TẬP <span aria-hidden="true">{% render 'helios-arrow' %}</span></span>
        </a>
      </div>
    {% endfor %}
  </div>
  {% if section.blocks.size > 1 %}
    <div class="helios-hero__controls" hidden data-helios-controls>
      <button type="button" data-helios-prev aria-label="Banner trước">←</button>
      <div class="helios-hero__dots">{% for block in section.blocks %}<button type="button" class="helios-hero__dot" data-helios-dot="{{ forloop.index0 }}" aria-label="Xem banner {{ forloop.index }}: {{ block.settings.title | escape }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>{% endfor %}</div>
      <span class="visually-hidden" data-helios-status aria-live="off" aria-atomic="true">1 / {{ section.blocks.size }}</span>
      <button type="button" data-helios-next aria-label="Banner tiếp theo">→</button>
      <button type="button" data-helios-toggle aria-label="Tạm dừng tự động chuyển banner"><span aria-hidden="true">Ⅱ</span></button>
    </div>
  {% endif %}
</helios-carousel>
{% schema %}
{
  "name": "HELIOS · Banner",
  "enabled_on": { "templates": ["index"] },
  "max_blocks": 5,
  "settings": [{ "type": "text", "id": "heading", "label": "Tiêu đề trang", "default": "HELIOS — Dấu ấn của bản lĩnh" }, { "type": "range", "id": "autoplay", "min": 0, "max": 10, "step": 1, "unit": "s", "default": 7, "label": "Tự chuyển banner (0: tắt)" }],
  "blocks": [{
    "type": "slide", "name": "Banner",
    "settings": [
      { "type": "text", "id": "title", "label": "Mô tả banner", "default": "HELIOS Signature Collections" },
      { "type": "select", "id": "film", "label": "Phim trang sức", "options": [{ "value": "rings", "label": "Nhẫn bạc trên đá" }, { "value": "diamond", "label": "Ánh sáng kim cương" }, { "value": "case", "label": "Đường nét nhẫn bạc" }], "default": "rings" },
      { "type": "collection", "id": "collection", "label": "Bộ sưu tập đích (để trống: tất cả sản phẩm)" }
    ]
  }],
  "presets": [{ "name": "HELIOS · Banner", "blocks": [{ "type": "slide" }] }]
}
{% endschema %}
