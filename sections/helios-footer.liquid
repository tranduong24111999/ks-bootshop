{{ 'wes-footer.css' | asset_url | stylesheet_tag }}
<footer class="helios-footer wes-footer">
  {% unless request.page_type == 'product' %}
  <section class="helios-newsletter" aria-labelledby="helios-newsletter-heading" style="background-image: url({{ 'helios-newsletter.jpg' | asset_url }});">
    <div class="helios-newsletter__content" data-helios-reveal><h2 id="helios-newsletter-heading">{{ 'helios.newsletter' | t }}</h2><p>{{ 'helios.newsletter_description' | t }}</p>
      {% assign newsletter_id = 'HeliosNewsletter-' | append: section.id %}
      {% form 'customer', id: newsletter_id, class: 'helios-newsletter__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="HeliosEmail-{{ section.id }}">{{ 'helios.email' | t }}</label>
        <div class="helios-newsletter__field"><input id="HeliosEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'helios.your_email' | t | escape }}" required {% if form.errors %}aria-invalid="true" aria-describedby="HeliosEmailError-{{ section.id }}"{% endif %}><button type="submit" aria-label="{{ 'helios.subscribe' | t | escape }}">{% render 'svg-icons', icon: 'arrow-right', size: 24 %}</button></div>
        {% if form.posted_successfully? %}<p role="status" tabindex="-1">{{ 'helios.thanks' | t }}</p>{% endif %}
        {% if form.errors %}<div id="HeliosEmailError-{{ section.id }}" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
        {% if shop.privacy_policy != blank %}<p class="helios-newsletter__notice">{{ 'helios.privacy_notice' | t }} <a href="{{ shop.privacy_policy.url }}">{{ 'helios.privacy_link' | t }}</a>.</p>{% endif %}
      {% endform %}
    </div>
  </section>
  {% endunless %}
  {% liquid
    assign contact_email = section.settings.contact_email | default: 'wesfreedkr@gmail.com'
    assign company_name = section.settings.company_name | default: 'Công ty TNHH wesfreed'
    assign company_address = section.settings.company_address | default: '1217 Meyrin, Switzerland'
    assign faq_page = section.settings.faq_page
    if faq_page == blank
      assign faq_page = pages['faq']
    endif
    if faq_page == blank
      assign faq_page = pages['faqs']
    endif
  %}
  <div class="helios-footer__frame wes-footer__frame">
    <div class="wes-footer__grid">
      <div class="wes-footer__brand" id="helios-story">
        <h2>{{ 'wes_footer.store' | t }}</h2>
        <p class="wes-footer__intro">{{ 'wes_footer.description' | t }}</p>
        <div class="wes-footer__company">
          <p>{{ company_name | escape }}</p>
          <address>{{ company_address | escape }}</address>
        </div>
        {% if section.settings.social_instagram != blank and section.settings.social_instagram != '#' %}
          <div class="wes-footer__social">
            <a href="{{ section.settings.social_instagram | escape }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram @wesfreedkr">
              <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
            </a>
          </div>
        {% endif %}
      </div>
      <nav class="wes-footer__nav" aria-label="{{ 'wes_footer.about' | t | escape }}">
        <h2>{{ 'wes_footer.about' | t }}</h2>
        {% if section.settings.about_menu.links != blank %}
          {% for link in section.settings.about_menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}
        {% else %}
          <a href="{{ routes.root_url }}#helios-story">{{ 'wes_footer.brand' | t }}</a>
          {% if section.settings.contact_page != blank %}<a href="{{ section.settings.contact_page.url }}">{{ 'wes_footer.inquiry' | t }}</a>{% else %}<a href="mailto:{{ contact_email | escape }}">{{ 'wes_footer.inquiry' | t }}</a>{% endif %}
          {% if faq_page.url != blank %}<a href="{{ faq_page.url }}">{{ 'wes_footer.faq' | t }}</a>{% endif %}
        {% endif %}
      </nav>
      <nav class="wes-footer__nav" aria-label="{{ 'wes_footer.service' | t | escape }}">
        <h2>{{ 'wes_footer.service' | t }}</h2>
        <a href="{{ routes.cart_url }}">{{ 'wes_footer.cart' | t }}</a>
        {% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">{{ 'wes_footer.account' | t }}</a>{% endif %}
        {% if shop.privacy_policy.body != blank %}<a href="{{ shop.privacy_policy.url }}">{{ 'wes_footer.privacy' | t }}</a>{% endif %}
        {% if shop.shipping_policy.body != blank %}<a href="{{ shop.shipping_policy.url }}">{{ 'wes_footer.shipping' | t }}</a>{% endif %}
        {% if shop.refund_policy.body != blank %}<a href="{{ shop.refund_policy.url }}">{{ 'wes_footer.returns' | t }}</a>{% endif %}
      </nav>
      <div class="wes-footer__contact">
        <h2>{{ 'wes_footer.contact' | t }}</h2>
        <a class="wes-footer__email" href="mailto:{{ contact_email | escape }}">{{ contact_email | escape }}</a>
        <p>{{ 'wes_footer.contact_note' | t }}</p>
      </div>
    </div>
    <div class="wes-footer__bottom">
      <div class="wes-footer__preferences">
        {% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}
          {% assign footer_localization_id = 'WesFooterLocalization-' | append: section.id %}
          {% form 'localization', id: footer_localization_id, class: 'wes-footer__localization' %}
            {% if localization.available_countries.size > 1 %}
              <label class="visually-hidden" for="WesFooterCountry-{{ section.id }}">{{ 'wes_footer.country' | t }}</label>
              <select name="country_code" id="WesFooterCountry-{{ section.id }}">
                {% for country in localization.available_countries %}<option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>{{ country.name | escape }} | {{ country.currency.iso_code }} {{ country.currency.symbol }}</option>{% endfor %}
              </select>
            {% endif %}
            {% if localization.available_languages.size > 1 %}
              <label class="visually-hidden" for="WesFooterLanguage-{{ section.id }}">{{ 'wes_footer.language' | t }}</label>
              <select name="language_code" id="WesFooterLanguage-{{ section.id }}">
                {% for language in localization.available_languages %}<option value="{{ language.iso_code }}" lang="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>{{ language.endonym_name | escape }}</option>{% endfor %}
              </select>
            {% endif %}
            <button type="submit">{{ 'wes_footer.apply' | t }}</button>
          {% endform %}
        {% endif %}
        <small>© {{ 'now' | date: '%Y' }}, WES FREED.</small>
      </div>
      <div class="wes-footer__checkout">
        {% if shop.enabled_payment_types.size > 0 %}
          <ul class="wes-footer__payments" aria-label="{{ 'wes_footer.payments' | t | escape }}">
            {% for payment_type in shop.enabled_payment_types %}<li>{{ payment_type | payment_type_svg_tag: class: 'wes-footer__payment-icon' }}</li>{% endfor %}
          </ul>
        {% endif %}
        {% if shop.privacy_policy.body != blank %}<a href="{{ shop.privacy_policy.url }}">{{ 'wes_footer.privacy' | t }}</a>{% endif %}
      </div>
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "WES FREED · Footer",
  "limit": 1,
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "company_name",
      "label": "Tên công ty",
      "default": "Công ty TNHH wesfreed"
    },
    {
      "type": "text",
      "id": "company_address",
      "label": "Địa chỉ",
      "default": "1217 Meyrin, Switzerland"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Email liên hệ",
      "default": "wesfreedkr@gmail.com"
    },
    {
      "type": "link_list",
      "id": "about_menu",
      "label": "Menu giới thiệu (tùy chọn)"
    },
    {
      "type": "page",
      "id": "contact_page",
      "label": "Trang liên hệ (tùy chọn)"
    },
    {
      "type": "page",
      "id": "faq_page",
      "label": "Trang câu hỏi thường gặp (tùy chọn)"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram"
    }
  ]
}
{% endschema %}
