<div class="helios-mega__columns">
  {% if menu.links != blank %}
    {% for link in menu.links %}
      <details class="helios-mega__group" open><summary>{{ link.title | escape }}</summary><div>
        <a href="{{ link.url }}">Xem tất cả {{ link.title | escape }}</a>
        {% for child in link.links %}<a href="{{ child.url }}">{{ child.title | escape }}</a>{% for grandchild in child.links %}<a class="helios-submenu__child" href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a>{% endfor %}{% endfor %}
      </div></details>
    {% endfor %}
  {% else %}
    <details class="helios-mega__group" open><summary>ALL PRODUCTS</summary><div>
      <a href="{{ routes.all_products_collection_url }}?sort_by=created-descending">MỚI NHẤT</a>
      {% render 'helios-link', handle: 'nguoi-moi-nen-chon', label: 'NGƯỜI MỚI NÊN CHỌN', query: 'bạc' %}
      {% render 'helios-link', handle: 'san-pham-an-tuong', label: 'ẤN TƯỢNG NHẤT', query: 'bạc' %}
      {% render 'helios-link', handle: 'nhan-bac-doi', label: 'NHẪN ĐÔI', query: 'nhẫn đôi' %}
      <a class="helios-menu-mobile-only" href="{{ routes.all_products_collection_url }}">TẤT CẢ SẢN PHẨM</a>
    </div></details>
    <details class="helios-mega__group" open><summary>JEWELRY</summary><div>
      {% render 'helios-link', handle: 'nhan-bac-nam', label: 'NHẪN BẠC', query: 'nhẫn' %}
      {% render 'helios-link', handle: 'vong-tay-bac-nam', label: 'VÒNG TAY BẠC', query: 'vòng tay' %}
      {% render 'helios-link', handle: 'day-chuyen-bac-s925', label: 'DÂY CHUYỀN BẠC', query: 'dây chuyền' %}
      {% render 'helios-link', handle: 'mat-day-chuyen-bac-s925', label: 'MẶT DÂY CHUYỀN BẠC', query: 'mặt dây chuyền' %}
      {% render 'helios-link', handle: 'charms', label: 'CHARM BẠC', query: 'charm' %}
      {% render 'helios-link', handle: 'khuyen-tai-bac-nam', label: 'KHUYÊN TAI BẠC', query: 'khuyên tai' %}
      {% render 'helios-link', handle: 'trang-suc-vang', label: 'TRANG SỨC VÀNG', query: 'vàng' %}
    </div></details>
    <details class="helios-mega__group" open><summary>ACCESSORIES</summary><div>
      {% render 'helios-link', handle: 'kinh-mat', label: 'KÍNH MẮT', query: 'kính' %}
      {% render 'helios-link', handle: 'leather-items', label: 'CHẾ TÁC DA', query: 'da' %}
      {% render 'helios-link', handle: 'accessories', label: 'PHỤ KIỆN KHÁC', query: 'phụ kiện' %}
    </div></details>
  {% endif %}
</div>
<div class="helios-mega__promos">
  <a href="{{ routes.all_products_collection_url }}" class="helios-mega__promo"><img src="{{ 'helios-story.jpg' | asset_url }}" width="1000" height="1250" alt="Khám phá chế tác HELIOS" loading="lazy"><span>KHÁM PHÁ CHẾ TÁC<span class="helios-mega__button">Khám phá</span></span></a>
  <a href="{{ stores_url }}" class="helios-mega__promo"><img src="{{ 'helios-store.jpg' | asset_url }}" width="800" height="1066" alt="Hệ thống cửa hàng HELIOS" loading="lazy"><span>HỆ THỐNG CỬA HÀNG<span class="helios-mega__button">Tìm ngay</span></span></a>
</div>
<div class="helios-menu-mobile-only helios-menu-mobile-links"><a href="{{ newest_url }}">NEW IN</a><a href="{{ feedback_url }}">FEEDBACK</a><a href="{{ collab_url }}">COLLAB</a><a href="{{ routes.root_url }}#helios-story">ABOUT HELIOS</a><a href="{{ stores_url }}">HỆ THỐNG CỬA HÀNG</a>{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">Đăng ký / Đăng nhập</a>{% endif %}</div>
