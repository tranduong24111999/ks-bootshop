<div class="helios-mega__columns">
  {% if menu.links != blank %}
    {% for link in menu.links %}
      <details class="helios-mega__group" open><summary>{% render 'helios-text', value: link.title %}</summary><div>
        <a href="{{ link.url }}">{% render 'helios-text', value: link.title %} — {{ 'helios.view_all' | t }}</a>
        {% for child in link.links %}<a href="{{ child.url }}">{% render 'helios-text', value: child.title %}</a>{% for grandchild in child.links %}<a class="helios-submenu__child" href="{{ grandchild.url }}">{% render 'helios-text', value: grandchild.title %}</a>{% endfor %}{% endfor %}
      </div></details>
    {% endfor %}
  {% else %}
    <details class="helios-mega__group" open><summary>{{ 'helios.all_products' | t }}</summary><div>
      <a href="{{ routes.all_products_collection_url }}?sort_by=created-descending">{{ 'helios.newest' | t }}</a>
      {% render 'helios-link', handle: 'nguoi-moi-nen-chon', label: 'NGƯỜI MỚI NÊN CHỌN', query: 'bạc' %}
      {% render 'helios-link', handle: 'san-pham-an-tuong', label: 'ẤN TƯỢNG NHẤT', query: 'bạc' %}
      {% render 'helios-link', handle: 'nhan-bac-doi', label: 'NHẪN ĐÔI', query: 'nhẫn đôi' %}
      <a class="helios-menu-mobile-only" href="{{ routes.all_products_collection_url }}">{{ 'helios.all_products' | t }}</a>
    </div></details>
    <details class="helios-mega__group" open><summary>{{ 'wes_header.jewelry' | t }}</summary><div>
      {% render 'helios-link', handle: 'nhan-bac-nam', label: 'NHẪN BẠC', query: 'nhẫn' %}
      {% render 'helios-link', handle: 'vong-tay-bac-nam', label: 'VÒNG TAY BẠC', query: 'vòng tay' %}
      {% render 'helios-link', handle: 'day-chuyen-bac-s925', label: 'DÂY CHUYỀN BẠC', query: 'dây chuyền' %}
      {% render 'helios-link', handle: 'mat-day-chuyen-bac-s925', label: 'MẶT DÂY CHUYỀN BẠC', query: 'mặt dây chuyền' %}
      {% render 'helios-link', handle: 'charms', label: 'CHARM BẠC', query: 'charm' %}
      {% render 'helios-link', handle: 'khuyen-tai-bac-nam', label: 'KHUYÊN TAI BẠC', query: 'khuyên tai' %}
      {% render 'helios-link', handle: 'trang-suc-vang', label: 'TRANG SỨC VÀNG', query: 'vàng' %}
    </div></details>
    <details class="helios-mega__group" open><summary>{{ 'wes_header.accessories' | t }}</summary><div>
      {% render 'helios-link', handle: 'kinh-mat', label: 'KÍNH MẮT', query: 'kính' %}
      {% render 'helios-link', handle: 'leather-items', label: 'CHẾ TÁC DA', query: 'da' %}
      {% render 'helios-link', handle: 'accessories', label: 'PHỤ KIỆN KHÁC', query: 'phụ kiện' %}
    </div></details>
  {% endif %}
</div>
<div class="helios-mega__promos">
  <a href="{{ routes.all_products_collection_url }}" class="helios-mega__promo"><img src="{{ 'helios-story.jpg' | asset_url }}" width="1000" height="1250" alt="{{ 'helios.craft_image' | t | escape }}" loading="lazy"><span>{{ 'helios.craft' | t }}<span class="helios-mega__button">{{ 'helios.discover' | t }}</span></span></a>
  {% unless stores_url contains '/pages/contact' %}<a href="{{ stores_url }}" class="helios-mega__promo"><img src="https://cdn.shopify.com/s/files/1/0836/2724/5625/files/wes-freed-jewelry-showroom.png?v=1793871659" width="1536" height="1024" alt="{{ 'helios.store_image' | t | escape }}" loading="lazy"><span>{{ 'helios.stores_upper' | t }}<span class="helios-mega__button">{{ 'helios.find' | t }}</span></span></a>{% else %}<a href="{{ stores_url }}" class="helios-mega__promo wes-care-menu"><span>{{ 'wes_polish.customer_care' | t }}<span class="helios-mega__button">{{ 'wes_polish.care_intro' | t }}</span></span></a>{% endunless %}
</div>
<div class="helios-menu-mobile-only helios-menu-mobile-links"><a href="{{ newest_url }}">{{ 'wes_header.new_in' | t }}</a><a href="{{ feedback_url }}">{{ 'wes_header.feedback' | t }}</a><a href="{{ collab_url }}">{{ 'wes_header.collab' | t }}</a>{% capture journal_url %}{% render 'helios-journal-url' %}{% endcapture %}<a href="{{ journal_url | strip }}">{{ 'wes_header.world' | t }}</a><a href="{{ routes.root_url }}#helios-story">{{ 'wes_header.about' | t }}</a><a href="{{ stores_url }}">{% if stores_url contains '/pages/contact' %}{{ 'wes_polish.customer_care' | t }}{% else %}{{ 'helios.stores_upper' | t }}{% endif %}</a>{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">{{ 'helios.login' | t }}</a>{% endif %}</div>


<style>.wes-care-menu{display:flex;align-items:center;justify-content:center;min-height:180px;background:#eeece6;color:#24231f;padding:24px}.wes-care-menu>span{position:static!important;transform:none!important;color:inherit!important}.wes-care-menu .helios-mega__button{white-space:normal;line-height:1.6}</style>
