{% doc %}
  Displays the active WES FREED quantity discount and worldwide shipping offer.
{% enddoc %}
{{ 'wes-quantity-offer.css' | asset_url | stylesheet_tag }}
<aside class="wes-quantity-offer" aria-label="{{ 'wes_quantity_offer.title' | t | escape }}">
  <p class="wes-quantity-offer__heading"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 8h18v4H3zM5 12v9h14v-9M12 8v13"/><path d="M12 8H8a3 3 0 1 1 3-3l1 3Zm0 0h4a3 3 0 1 0-3-3l-1 3Z"/></svg><strong>{{ 'wes_quantity_offer.title' | t }}</strong></p>
  <ul class="wes-quantity-offer__tiers">
    <li><span>{{ 'wes_quantity_offer.two_items' | t }}</span><span aria-hidden="true">→</span><strong>{{ 'wes_quantity_offer.five_off' | t }}</strong></li>
    <li><span>{{ 'wes_quantity_offer.three_items' | t }}</span><span aria-hidden="true">→</span><strong>{{ 'wes_quantity_offer.ten_shipping' | t }}</strong></li>
  </ul>
  <div class="wes-quantity-offer__notes"><p>{{ 'wes_quantity_offer.mix_note' | t }}</p><p>{{ 'wes_quantity_offer.shipping_note' | t }}</p></div>
</aside>
