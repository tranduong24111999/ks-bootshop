{% assign editorial_sheets = 'https://cdn.shopify.com/s/files/1/0836/2724/5625/files/wes-freed-korean-editorial-1.png?v=1793958770|https://cdn.shopify.com/s/files/1/0836/2724/5625/files/wes-freed-korean-editorial-2.png?v=1793958784|https://cdn.shopify.com/s/files/1/0836/2724/5625/files/wes-freed-korean-editorial-3.png?v=1793958799|https://cdn.shopify.com/s/files/1/0836/2724/5625/files/wes-freed-korean-editorial-4.png?v=1793958815' | split: '|' %}
<p class="wes-lookbook__note">{{ 'wes_lookbook.note' | t }}</p>
{% assign look_number = 0 %}
{% for sheet in editorial_sheets %}
  {% for quadrant in (1..4) %}
    {% assign look_number = look_number | plus: 1 %}
    {% assign crop_x = '0%' %}
    {% assign crop_y = '0%' %}
    {% if quadrant == 2 or quadrant == 4 %}{% assign crop_x = '-100%' %}{% endif %}
    {% if quadrant > 2 %}{% assign crop_y = '-100%' %}{% endif %}
    <article class="helios-feedback__card">
      <a class="wes-lookbook__image" href="{{ routes.all_products_collection_url }}" style="--crop-x:{{ crop_x }};--crop-y:{{ crop_y }};">
        <img src="{{ sheet | escape }}" width="1024" height="1536" alt="{{ 'wes_lookbook.portrait_alt' | t: number: look_number | escape }}" loading="lazy">
      </a>
      <a class="wes-lookbook__caption" href="{{ routes.all_products_collection_url }}">{{ 'wes_lookbook.look_label' | t: number: look_number }}</a>
    </article>
  {% endfor %}
{% endfor %}
