{% liquid
  assign destination = blank
  if kind == 'page'
    assign destination = pages[handle].url
  else
    assign destination = collections[handle].url
  endif
  if kind == 'page' and handle == 'feedback'
    capture destination
      render 'helios-feedback-url'
    endcapture
    assign destination = destination | strip
  endif
  if kind == 'page' and handle == 'helios-partnership' and label == 'Collab'
    capture destination
      render 'helios-collab-url'
    endcapture
    assign destination = destination | strip
  endif
  if destination == blank
    if query == blank
      assign destination = routes.all_products_collection_url
    else
      assign localized_query = query
      case query
        when 'bạc'
          assign localized_query = 'wes_search_terms.term_0' | t
        when 'nhẫn đôi'
          assign localized_query = 'wes_search_terms.term_1' | t
        when 'nhẫn'
          assign localized_query = 'wes_search_terms.term_2' | t
        when 'vòng tay'
          assign localized_query = 'wes_search_terms.term_3' | t
        when 'dây chuyền'
          assign localized_query = 'wes_search_terms.term_4' | t
        when 'mặt dây chuyền'
          assign localized_query = 'wes_search_terms.term_5' | t
        when 'charm'
          assign localized_query = 'wes_search_terms.term_6' | t
        when 'khuyên tai'
          assign localized_query = 'wes_search_terms.term_7' | t
        when 'vàng'
          assign localized_query = 'wes_search_terms.term_8' | t
        when 'kính'
          assign localized_query = 'wes_search_terms.term_9' | t
        when 'da'
          assign localized_query = 'wes_search_terms.term_10' | t
        when 'phụ kiện'
          assign localized_query = 'wes_search_terms.term_11' | t
      endcase
      assign encoded_query = localized_query | url_encode
      assign search_type = 'product'
      if kind == 'page'
        assign search_type = 'page'
      endif
      assign destination = routes.search_url | append: '?type=' | append: search_type | append: '&q=' | append: encoded_query
    endif
  endif
%}
<a href="{{ destination }}">{% render 'helios-text', value: label %}</a>
