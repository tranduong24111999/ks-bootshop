{% doc %}
  @param {string} qr_url - Original KakaoTalk QR image URL supplied by the merchant.
{% enddoc %}
{% liquid
  case request.locale.iso_code
    when 'ko'
      assign title = 'KakaoTalk 문의'
      assign instructions = 'KakaoTalk에서 QR 코드를 스캔하여 Wesfreed를 친구로 추가해 주세요. 같은 휴대폰에서는 QR 이미지를 저장한 후 KakaoTalk QR 스캐너의 앨범에서 선택해 주세요.'
      assign open_image = 'QR 이미지 열기'
      assign close = '닫기'
    when 'vi'
      assign title = 'Liên hệ KakaoTalk'
      assign instructions = 'Quét mã QR bằng KakaoTalk để thêm Wesfreed. Nếu dùng cùng điện thoại, lưu ảnh QR rồi chọn ảnh từ thư viện trong trình quét QR của KakaoTalk.'
      assign open_image = 'Mở ảnh QR'
      assign close = 'Đóng'
    when 'ja'
      assign title = 'KakaoTalkでお問い合わせ'
      assign instructions = 'KakaoTalkでQRコードを読み取り、Wesfreedを友だちに追加してください。同じスマートフォンではQR画像を保存し、KakaoTalkのQRスキャナーからアルバムの画像を選択してください。'
      assign open_image = 'QR画像を開く'
      assign close = '閉じる'
    else
      assign title = 'Contact on KakaoTalk'
      assign instructions = 'Scan the QR code in KakaoTalk to add Wesfreed. On the same phone, save the QR image, then select it from your album in the KakaoTalk QR scanner.'
      assign open_image = 'Open QR image'
      assign close = 'Close'
  endcase
%}
{% if qr_url != blank %}
<button type="button" class="wes-instagram-button wes-kakao-button" aria-label="{{ title | escape }}" aria-controls="WesKakaoQR" data-wes-kakao-open>
  <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true"><path fill="currentColor" d="M14 3C6.8 3 1 7.3 1 12.7c0 3.4 2.3 6.4 5.8 8.1L5.3 26l6-3.9c.9.2 1.8.3 2.7.3 7.2 0 13-4.3 13-9.7S21.2 3 14 3Z"/><text x="14" y="16" text-anchor="middle" font-size="7" font-family="Arial,sans-serif" font-weight="bold" fill="#fee500">TALK</text></svg>
</button>
<dialog id="WesKakaoQR" class="wes-kakao-dialog" aria-labelledby="WesKakaoTitle">
  <div class="wes-kakao-heading"><h2 id="WesKakaoTitle">{{ title | escape }}</h2><button type="button" data-wes-kakao-close aria-label="{{ close | escape }}">×</button></div>
  <p>{{ instructions | escape }}</p>
  <img src="{{ qr_url | escape }}" alt="Wesfreed KakaoTalk QR" width="750" height="925" loading="lazy">
  <a href="{{ qr_url | escape }}" target="_blank" rel="noopener noreferrer">{{ open_image | escape }}</a>
</dialog>
<style>
.wes-kakao-button{right:152px;background:#fee500;color:#191919!important;padding:0;cursor:pointer}
.wes-kakao-dialog{width:min(420px,calc(100vw - 32px));max-height:calc(100dvh - 32px);padding:20px;border:0;border-radius:12px;background:#fff;color:#24231f;overflow:auto;overscroll-behavior:contain}
.wes-kakao-dialog::backdrop{background:rgb(0 0 0/.45)}
.wes-kakao-heading{display:flex;align-items:center;justify-content:space-between;gap:12px}
.wes-kakao-heading h2{font-size:20px;margin:0}
.wes-kakao-heading button{width:44px;height:44px;background:none;border:0;font-size:28px;color:inherit}
.wes-kakao-dialog p{font-size:13px;line-height:1.7;margin:12px 0}
.wes-kakao-dialog img{display:block;width:100%;height:auto}
.wes-kakao-dialog>a{display:block;text-align:center;padding:14px 0;min-height:44px;color:inherit;text-decoration:underline}
@media(max-width:767px){.wes-kakao-button{right:140px}}
</style>
<script>
(() => {
  const dialog = document.querySelector('#WesKakaoQR')
  const open = document.querySelector('[data-wes-kakao-open]')
  if (!dialog || !open || open.dataset.ready) return
  open.dataset.ready = 'true'
  open.addEventListener('click', () => dialog.showModal())
  dialog.querySelector('[data-wes-kakao-close]').addEventListener('click', () => dialog.close())
  dialog.addEventListener('click', event => {
    const box = dialog.getBoundingClientRect()
    if (event.target === dialog && (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom)) dialog.close()
  })
})()
</script>
{% endif %}
