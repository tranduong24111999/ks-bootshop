{% doc %}
  Displays a lightweight loading overlay during native page navigation.
  @example
  {% render 'wes-page-transition' %}
{% enddoc %}
{% unless request.design_mode %}
  <style>
    html::before,html::after{content:'';position:fixed;visibility:hidden;opacity:0;pointer-events:none;transition:opacity .24s ease,visibility 0s linear .24s}
    html::before{inset:0;z-index:2147483000;background:#3a3a3a}
    html::after{top:50%;left:calc(50% - min(120px,30vw));width:min(240px,60vw);height:2px;z-index:2147483001;background:#fff;transform:scaleX(1);transform-origin:left center}
    html[data-wes-page-transition]::before,html[data-wes-page-transition]::after{visibility:visible;opacity:1;transition:opacity .12s ease,visibility 0s}
    html[data-wes-page-transition]::after{animation:wes-navigation-progress 5s cubic-bezier(.16,1,.3,1) forwards;animation-delay:var(--wes-navigation-elapsed,0ms)}
    html[data-wes-page-transition="loading"]::before,html[data-wes-page-transition="loading"]::after{transition:none}
    html[data-wes-page-transition="finishing"]::before,html[data-wes-page-transition="finishing"]::after{opacity:0;transition:opacity .24s ease .08s}
    html[data-wes-page-transition="finishing"]::after{animation:none;transform:scaleX(1)}
    @keyframes wes-navigation-progress{from{transform:scaleX(.04)}to{transform:scaleX(.95)}}
    @media(prefers-reduced-motion:reduce){html::before,html::after,html[data-wes-page-transition]::before,html[data-wes-page-transition]::after{transition:none}html::after,html[data-wes-page-transition]::after{animation:none;transform:none}}
  </style>
  <script>
    (() => {
      const root = document.documentElement
      let failSafe
      let imageTimer
      let finishTimer
      const storageKey = 'wes-navigation-pending'
      let started = Date.now()
      try {
        const pending = JSON.parse(sessionStorage.getItem(storageKey) || 'null')
        sessionStorage.removeItem(storageKey)
        if (pending?.url === location.pathname + location.search && Date.now() - pending.started >= 0 && Date.now() - pending.started < 12000) started = pending.started
      } catch (_) {}
      const reset = () => {
        clearTimeout(failSafe)
        clearTimeout(imageTimer)
        clearTimeout(finishTimer)
        root.removeAttribute('data-wes-page-transition')
      }
      const show = (state, elapsed = 0) => {
        reset()
        root.style.setProperty('--wes-navigation-elapsed', `-${Math.min(elapsed, 4800)}ms`)
        root.dataset.wesPageTransition = state
        failSafe = setTimeout(reset, 5000)
      }
      const ready = () => {
        if (root.dataset.wesPageTransition !== 'loading') return
        const finish = () => {
          if (root.dataset.wesPageTransition !== 'loading') return
          clearTimeout(failSafe)
          clearTimeout(imageTimer)
          root.dataset.wesPageTransition = 'finishing'
          finishTimer = setTimeout(reset, 340)
        }
        const image = document.querySelector('#main img[fetchpriority="high"]')
        if (!image || image.complete) { finish(); return }
        image.addEventListener('load', finish, { once: true })
        image.addEventListener('error', finish, { once: true })
        imageTimer = setTimeout(finish, 900)
      }
      show('loading', Date.now() - started)
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', ready, { once: true })
      else ready()
      window.addEventListener('pageshow', event => { if (event.persisted) reset() })
      window.addEventListener('pagehide', () => {
        if (root.dataset.wesPageTransition !== 'leaving') reset()
      })
      window.addEventListener('popstate', reset)
      window.addEventListener('click', event => {
        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
        const anchor = event.target instanceof Element ? event.target.closest('a[href]') : null
        if (!anchor || anchor.hasAttribute('download') || anchor.target && anchor.target !== '_self' || anchor.hasAttribute('data-no-page-transition') || anchor.hasAttribute('data-bs-toggle') || anchor.hasAttribute('aria-controls') || anchor.getAttribute('role') === 'button' || anchor.hasAttribute('onclick')) return
        let url
        try { url = new URL(anchor.href, location.href) } catch (_) { return }
        if (!/^https?:$/.test(url.protocol) || url.origin !== location.origin) return
        if (url.pathname === location.pathname && url.search === location.search) return
        if (/^\/(?:[a-z]{2}(?:-[a-z]{2})?\/)?(?:cart|checkout|checkouts|account|apps|admin|payments|discount|localization)(?:\/|$)/i.test(url.pathname)) return
        try { sessionStorage.setItem(storageKey, JSON.stringify({ url: url.pathname + url.search, started: Date.now() })) } catch (_) {}
        show('leaving')
      })
    })()
  </script>
{% endunless %}

