{% doc %}
  Displays the current Korea-only shipping fees and delivery estimate.
{% enddoc %}
{% assign shipping_information_url = routes.root_url | append: '/pages/shipping-information' | replace: '//', '/' %}
<p class="wes-shipping-summary">{{ 'wes_shipping.summary_html' | t }}<br><a href="{{ shipping_information_url }}">{{ 'wes_shipping.details' | t }}</a></p>
{% stylesheet %}
.wes-shipping-summary{margin:12px 0;font-size:12px;line-height:1.65;font-weight:400;letter-spacing:0}
.wes-shipping-summary strong{font-weight:500}
.wes-shipping-summary a{color:inherit;text-underline-offset:3px}
{% endstylesheet %}
