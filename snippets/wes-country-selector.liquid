{% liquid
  assign countries = localization.available_countries | sort: 'name'
  assign current_country = localization.country | default: countries.first
  assign current_language = localization.language.iso_code | default: request.locale.iso_code
%}
{% if countries.size > 0 %}
  <details class="wes-country-selector" data-helios-language>
    <summary aria-label="{{ current_country.name | escape }} | {{ current_country.currency.iso_code }} {{ current_country.currency.symbol }}" title="{{ current_country.name | escape }} | {{ current_country.currency.iso_code }} {{ current_country.currency.symbol }}">
      <span class="wes-country-selector__name">{{ current_country.name | escape }} |</span>
      <span class="wes-country-selector__currency">{{ current_country.currency.iso_code }} <span class="wes-country-selector__symbol">{{ current_country.currency.symbol }}</span></span>
      <svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true" focusable="false"><path d="m2 4 4 4 4-4"/></svg>
    </summary>
    {% form 'localization', id: form_id, class: 'wes-country-selector__options' %}
      {% if current_language != blank %}<input type="hidden" name="language_code" value="{{ current_language | escape }}">{% endif %}
      {% for country in countries %}
        <button type="submit" name="country_code" value="{{ country.iso_code }}" {% if country.iso_code == current_country.iso_code %}aria-current="true"{% endif %}>
          <span class="wes-country-selector__check" aria-hidden="true">{% if country.iso_code == current_country.iso_code %}✓{% endif %}</span><span class="wes-country-selector__label">{{ country.name | escape }}</span>
        </button>
      {% endfor %}
    {% endform %}
  </details>
{% endif %}
