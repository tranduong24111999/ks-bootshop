{% liquid
  case request.locale.iso_code
    when 'ko'
      assign facebook_nudge = '주문 도와드려요'
      assign instagram_nudge = '스타일 추천받기'
      assign prompt_one = '주문은 어떻게 하나요?'
      assign prompt_two = '구매 또는 제품 상담이 필요하시면 Instagram으로 메시지를 보내주세요.'
      assign prompt_close = '안내 닫기'
    when 'vi'
      assign facebook_nudge = 'Hỗ trợ đặt hàng'
      assign instagram_nudge = 'Chọn mẫu hợp bạn'
      assign prompt_one = 'Bạn cần tư vấn đặt hàng?'
      assign prompt_two = 'Nhắn Instagram để được tư vấn sản phẩm và hướng dẫn mua hàng.'
      assign prompt_close = 'Đóng lời nhắc'
    when 'ja'
      assign facebook_nudge = 'ご注文をサポート'
      assign instagram_nudge = '似合う一品を相談'
      assign prompt_one = 'ご注文についてお困りですか？'
      assign prompt_two = '商品やご購入のご相談はInstagramのメッセージでどうぞ。'
      assign prompt_close = '案内を閉じる'
    else
      assign facebook_nudge = 'Help with your order'
      assign instagram_nudge = 'Find your style'
      assign prompt_one = 'Need help placing an order?'
      assign prompt_two = 'Message us on Instagram for product advice and help with your order.'
      assign prompt_close = 'Dismiss reminder'
  endcase
%}
<div class="wes-instagram-widget" data-wes-instagram-widget>
<a class="wes-instagram-button wes-facebook-button" href="https://www.facebook.com/profile.php?id=61596233609365" target="_blank" rel="noopener noreferrer" aria-label="Facebook WES FREED — {{ facebook_nudge | escape }}" title="Facebook WES FREED">
  <span class="wes-contact-nudge" aria-hidden="true">{{ facebook_nudge | escape }}</span>
  <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14.2 21v-8.2H17l.4-3.2h-3.2V7.5c0-.9.3-1.6 1.6-1.6h1.7V3.1c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.4H8v3.2h2.8V21Z"/></svg>
</a>
<a class="wes-instagram-button" href="https://www.instagram.com/wesfreedkr/" target="_blank" rel="noopener noreferrer" aria-label="Instagram @wesfreedkr — {{ instagram_nudge | escape }}" title="Instagram @wesfreedkr">
  <span class="wes-contact-nudge" aria-hidden="true">{{ instagram_nudge | escape }}</span>
  <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
    <rect x="3" y="3" width="18" height="18" rx="5" />
    <circle cx="12" cy="12" r="4.2" />
    <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
  </svg>
</a>
<style>
  .wes-instagram-button {
    position:fixed; right:20px; bottom:calc(96px + env(safe-area-inset-bottom, 0px)); z-index:999;
    display:flex; align-items:center; justify-content:center; width:56px; height:56px;
    box-sizing:border-box; border:2px solid #fff; border-radius:50%;
    background:radial-gradient(circle at 30% 105%,#feda75 0%,#fa7e1e 24%,#d62976 52%,#962fbf 76%,#4f5bd5 100%);
    color:#fff!important; text-decoration:none; box-shadow:0 3px 12px #0003;
    transition:transform .18s ease,box-shadow .18s ease;
  }
  .wes-instagram-button svg { display:block; width:28px; height:28px; flex:none; }
  .wes-instagram-button:hover { transform:translateY(-2px); box-shadow:0 5px 16px #0004; }
  .wes-instagram-button:focus-visible { outline:3px solid #262626; outline-offset:3px; }
  @media(max-width:767px) {
    .wes-instagram-button { right:16px; bottom:calc(92px + env(safe-area-inset-bottom, 0px)); width:52px; height:52px; }
    .wes-instagram-button svg { width:26px; height:26px; }
  }
  @media(prefers-reduced-motion:reduce) {
    .wes-instagram-button { transition:none; }
    .wes-instagram-button:hover { transform:none; }
  }
  @media print { .wes-instagram-button { display:none; } }
</style>

</div>
<style>
.wes-instagram-prompt { position:fixed; right:20px; bottom:calc(166px + env(safe-area-inset-bottom, 0px)); z-index:999; width:280px; max-width:calc(100vw - 32px); padding:16px 32px 16px 18px; box-sizing:border-box; border:1px solid #e5e2dc; border-radius:12px; background:#fff; color:#222; box-shadow:0 4px 20px #0002; opacity:0; transform:translateY(8px); transition:opacity .28s ease,transform .28s ease; }
.wes-instagram-prompt[hidden] { display:none; }
.wes-instagram-prompt.is-visible { opacity:1; transform:translateY(0); }
.wes-instagram-prompt::after { content:''; position:absolute; bottom:-7px; right:21px; width:12px; height:12px; background:#fff; border-right:1px solid #e5e2dc; border-bottom:1px solid #e5e2dc; transform:rotate(45deg); }
.wes-instagram-prompt a { display:block; color:inherit; text-decoration:none; font:13px/1.6 Arial,sans-serif; }
.wes-instagram-prompt__close { position:absolute; right:3px; top:3px; width:28px; height:28px; padding:0; border:0; background:transparent; color:#666; font:20px/1 Arial,sans-serif; cursor:pointer; }
.wes-instagram-prompt a:focus-visible,.wes-instagram-prompt__close:focus-visible { outline:2px solid #262626; outline-offset:2px; }
@media(max-width:767px) { .wes-instagram-prompt { right:16px; bottom:calc(158px + env(safe-area-inset-bottom, 0px)); width:260px; } }
@media(prefers-reduced-motion:reduce) { .wes-instagram-prompt { transition:none; transform:none; } }
@media print { .wes-instagram-prompt { display:none; } }
</style>


<style>
.wes-facebook-button{right:86px;background:#1877f2}
@media(max-width:767px){.wes-facebook-button{right:78px}}
</style>

{% render 'wes-kakao-contact', qr_url: 'https://cdn.shopify.com/s/files/1/0836/2724/5625/files/d569d00b-a517-4a54-9c76-b2066d08a639.jpg?v=1794458125' %}


<style>
.wes-instagram-button{right:16px;bottom:calc(76px + env(safe-area-inset-bottom,0px));width:44px;height:44px}
.wes-instagram-button svg{width:24px;height:24px}
.wes-facebook-button{right:16px;bottom:calc(128px + env(safe-area-inset-bottom,0px))}
@media(max-width:767px){.wes-instagram-button,.wes-facebook-button{right:12px}}
</style>

<style>
.wes-contact-nudge{position:absolute;right:calc(100% + 8px);top:50%;transform:translateY(-50%);display:block;width:max-content;max-width:min(145px,calc(100vw - 80px));padding:5px 9px;border:1px solid #e5e1d8;border-radius:16px;background:#fff;color:#282621;font:500 12px/1.3 Arial,sans-serif;white-space:nowrap;box-shadow:0 2px 7px #0001}
@media(max-width:767px){.wes-contact-nudge{font-size:11px;padding:5px 8px}}
</style>
